+def _pin_checkout(openpilot_dir: Path, commit: str) -> None:
+    head = subprocess.run(["git", "rev-parse", "HEAD"], cwd=openpilot_dir, capture_output=True, text=True).stdout.strip()
+    if head != commit:
+        _run(["git", "fetch", "--depth", "1", "origin", commit], cwd=openpilot_dir)
+        # --force drops the runtime patches from the last render; they are re-applied before the next one
+        _run(["git", "checkout", "--force", commit], cwd=openpilot_dir)
+        _run(["git", "submodule", "update", "--init", "--recursive"], cwd=openpilot_dir)
+    # without a local install the smudge filter never runs and assets stay as LFS pointer files
+    _run(["git", "lfs", "install", "--local"], cwd=openpilot_dir)
+    _run(["git", "lfs", "pull"], cwd=openpilot_dir)
+
+
